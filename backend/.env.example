
DATABASE_URL=postgresql://fai:replace-me@127.0.0.1:5432/fai
HOST=127.0.0.1
PORT=8080
# See INTEGRATIONS.md for Python runtimes, model endpoints and scoped shop bindings.
# FAI_PLUGIN_INTEGRATIONS_FILE=/etc/f-ai/plugin-integrations.json
# FAI_MEDIA_SKILLS_FILE=/etc/f-ai/media-skills.json
# Optional Taobao seller authorization. Set all four through the deployment environment.
# FAI_TAOBAO_APP_KEY=
# FAI_TAOBAO_APP_SECRET=
# FAI_TAOBAO_REDIRECT_URI=https://studio.example.com/
# FAI_SHOP_GRANT_KEY=<64 hexadecimal characters; retain across restarts>
WEB_ORIGINS=http://localhost:5173
# GATEWAY_URL=https://provider.example/v1/run
# GATEWAY_TOKEN=
# GATEWAY_CAPABILITIES=image.main-image,copywriting.generate
# MODEL_PROVIDERS_FILE=./model-providers.example.json
# Or provide the same array directly in MODEL_PROVIDERS_JSON.
# SHOP_BINDINGS_JSON=[]
# FAI_FEATURE_RELEASES_JSON=[]
# EXA_API_KEY=
# CUSTOMER_ASSISTANT_LOCAL_MODEL_ID=local-support-model
# VIDEO_ARCHIVE_ORIGINS=https://media.example.com
# VIDEO_FFMPEG_PATH=/usr/bin/ffmpeg
# VIDEO_FFPROBE_PATH=/usr/bin/ffprobe
# VIDEO_EXPORT_ENCODER=libx264
# DEDICATED_DATABASES_JSON={"company-db":"COMPANY_DATABASE_URL"}
# Set COMPANY_DATABASE_URL through the deployment secret store.
# WEBDAV_BINDINGS_JSON=[{"workspaceId":"<workspace-id>","baseUrl":"https://files.example.test/project/","authorizationEnv":"COMPANY_WEBDAV_AUTH"}]
# FEISHU_BINDINGS_JSON=[{"id":"company-bot","workspaceId":"<workspace-id>","appId":"cli_example","tenantKey":"tenant_example","appSecretEnv":"FEISHU_APP_SECRET","encryptKeyEnv":"FEISHU_ENCRYPT_KEY","verificationTokenEnv":"FEISHU_VERIFICATION_TOKEN"}]
