
DATABASE_URL=postgresql://fai:replace-me@127.0.0.1:5432/fai
HOST=127.0.0.1
PORT=8080
WEB_ORIGINS=http://localhost:5173
# GATEWAY_URL=https://provider.example/v1/run
# GATEWAY_TOKEN=
# GATEWAY_CAPABILITIES=image.main-image,copywriting.generate
# MODEL_PROVIDERS_FILE=./model-providers.example.json
# REALTIME_VOICE_BINDINGS_JSON=[{"workspaceId":"<workspace-id>","model":"<realtime-model>","voice":"marin","keyEnv":"VOICE_PROVIDER_KEY","credits":2,"durationSeconds":180}]
# Or provide the same array directly in MODEL_PROVIDERS_JSON.
# SHOP_BINDINGS_JSON=[]
# EXA_API_KEY=
# WECHAT_BINDINGS_JSON=[{"channel":"wechat","id":"support","workspaceId":"<uuid>","receiver":"<app-id>","recipient":"<original-id>","tokenEnv":"WX_CALLBACK_TOKEN","keyEnv":"WX_ENCODING_KEY","replyText":"已收到您的消息。"}]
# FAI_LOG_KEEP_DAYS=7
# CUSTOMER_ASSISTANT_LOCAL_MODEL_ID=local-support-model
# VIDEO_ARCHIVE_ORIGINS=https://media.example.com
# VIDEO_FFMPEG_PATH=/usr/bin/ffmpeg
# VIDEO_FFPROBE_PATH=/usr/bin/ffprobe
# VIDEO_EXPORT_ENCODER=libx264
# DEDICATED_DATABASES_JSON={"company-db":{"credentialVersion":1}}
# DEDICATED_CREDENTIAL_DIR=/var/lib/fai/credentials
# DEDICATED_CREDENTIAL_KEYS_FILE=/run/secrets/fai.dbkeys.json
# SMS_BINDINGS_JSON=[{"workspaceId":"<workspace-id>","appId":"<sms-app-id>","signName":"<approved-signature>","region":"ap-guangzhou","secretIdEnv":"SMS_SECRET_ID","secretKeyEnv":"SMS_SECRET_KEY","templates":[{"alias":"order-update","id":"<approved-template-id>","params":1}]}]
# External probe process settings
# FAI_PROBE_ORIGIN=https://studio.example.test
# FAI_ALERT_SERVICE=studio-production
# FAI_ALERT_STATE_FILE=/var/lib/fai-monitor/alerts.sqlite
# FAI_ALERT_FORMAT=webhook
# FAI_ALERT_WEBHOOK_URL=https://receiver.example.test/events
# Inject FAI_ALERT_TOKEN for bearer-authenticated webhooks, or FAI_ALERT_SIGNING_SECRET for signed Feishu bots.
# WEBDAV_BINDINGS_JSON=[{"workspaceId":"<workspace-id>","baseUrl":"https://files.example.test/project/","authorizationEnv":"COMPANY_WEBDAV_AUTH"}]
# FEISHU_BINDINGS_JSON=[{"id":"company-bot","workspaceId":"<workspace-id>","appId":"cli_example","tenantKey":"tenant_example","appSecretEnv":"FEISHU_APP_SECRET","encryptKeyEnv":"FEISHU_ENCRYPT_KEY","verificationTokenEnv":"FEISHU_VERIFICATION_TOKEN"}]
