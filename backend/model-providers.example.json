  {
    "enabled": false,
    "id": "replicate-flux",
    "protocol": "json-http",
    "baseUrl": "https://api.replicate.com/v1",
    "model": "black-forest-labs/flux-schnell",
    "keyEnv": "FAI_REPLICATE_KEY",
    "capabilities": [
      "image.main-image"
    ],
    "mapping": {
      "kind": "image",
      "createPath": "models/black-forest-labs/flux-schnell/predictions",
      "body": {
        "input": {
          "prompt": {
            "$from": "prompt"
          },
          "aspect_ratio": {
            "$from": "parameters.ratio"
          }
        }
      },
      "poll": {
        "jobIdPath": "id",
        "path": "predictions/{id}",
        "statusPath": "status",
        "pending": [
          "starting",
          "processing"
        ],
        "success": [
          "succeeded"
        ]
      },
      "outputPath": "output.0",
      "outputFormat": "url"
    }
  },
  {
    "enabled": false,
    "id": "fal-flux",
    "protocol": "json-http",
    "baseUrl": "https://queue.fal.run/",
    "model": "fal-ai/flux/dev",
    "keyEnv": "FAI_FAL_KEY",
    "capabilities": [
      "image.main-image"
    ],
    "mapping": {
      "kind": "image",
      "authScheme": "Key",
      "createPath": "fal-ai/flux/dev",
      "body": {
        "prompt": {
          "$from": "prompt"
        }
      },
      "poll": {
        "jobIdPath": "request_id",
        "path": "fal-ai/flux/requests/{id}/status",
        "statusPath": "status",
        "pending": [
          "IN_QUEUE",
          "IN_PROGRESS"
        ],
        "success": [
          "COMPLETED"
        ],
        "resultPath": "fal-ai/flux/requests/{id}"
      },
      "outputPath": "images.0.url",
      "outputFormat": "url"
    }
  }
]
