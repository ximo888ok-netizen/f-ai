{
  "name": "@f-ai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend API for the f-ai e-commerce platform",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "studio:demo": "node src/local-studio.js",
    "migrate": "node src/admin.js migrate",
    "ops:probe": "node src/ops-probe.js",
    "ops:logs": "node src/task-log-export.js",
    "ops:observe": "node src/ops-observation.js",
    "ops:capacity": "node src/deployment-capacity.js",
